-- // PLAYER SELECTOR & FEATURE LOGIC \\ --
local playerList, sIdx, bIdx, gIdx, fIdx = {}, 1, 1, 1, 1
local sTarget, bTarget, gTarget, fTarget = nil, nil, nil, nil
local bringPlt, bringActive, flingActive = nil, false, false

local function updatePlayerList()
    playerList = {}
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            table.insert(playerList, v)
        end
    end
end

local function handleSelect(typeStr)
    updatePlayerList()
    if #playerList == 0 then return end
    if typeStr == "s" then
        if sIdx > #playerList then sIdx = 1 end
        sTarget = playerList[sIdx]
        SpectateBtn.Text = sTarget.Name
        SpectateLabel.Text = "Spectating: " .. sTarget.Name
        sIdx = sIdx + 1
    elseif typeStr == "b" then
        if bIdx > #playerList then bIdx = 1 end
        bTarget = playerList[bIdx]
        BringSelect.Text = bTarget.Name
        BringLabel.Text = "Bring Target: " .. bTarget.Name
        bIdx = bIdx + 1
    elseif typeStr == "g" then
        if gIdx > #playerList then gIdx = 1 end
        gTarget = playerList[gIdx]
        GotoSelect.Text = gTarget.Name
        GotoLabel.Text = "Goto Target: " .. gTarget.Name
        gIdx = gIdx + 1
    elseif typeStr == "f" then
        if fIdx > #playerList then fIdx = 1 end
        fTarget = playerList[fIdx]
        FlingSelect.Text = fTarget.Name
        FlingLabel.Text = "Fling Target: " .. fTarget.Name
        fIdx = fIdx + 1
    end
end

SpectateRefresh.MouseButton1Click:Connect(function() sIdx = 1 handleSelect("s") end)
SpectateBtn.MouseButton1Click:Connect(function() handleSelect("s") end)
