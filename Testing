RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if spectateActive and currentSpectateTarget and currentSpectateTarget.Character then
        local hum = currentSpectateTarget.Character:FindFirstChildOfClass("Humanoid")
        if hum then Camera.CameraSubject = hum end
    elseif not spectateActive and char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and Camera.CameraSubject ~= hum then Camera.CameraSubject = hum end
    end
    
    if farmActive and FarmPlatform and hrp then
        if (hrp.Position - FarmPlatform.Position).Magnitude > 65 then
            hrp.CFrame = CFrame.new(FarmPlatform.Position + Vector3.new(0, 5, 0))
        end
        pcall(function()
            for _, v in ipairs(Workspace:GetChildren()) do
                if v:IsA("Model") and v ~= char and not Players:GetPlayerFromCharacter(v) and v ~= PracticeDummy then
                    local h = v:FindFirstChildOfClass("Humanoid")
                    local r = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso")
                    if h and r and h.Health > 0 then
                        r.CFrame = FarmPlatform.CFrame + Vector3.new(0, 4, 0)
                        r.Anchored = true
                        h.PlatformStand = true
                    end
                end
            end
        end)
    end
    
    if playerLockActive and PlayerLockPlatform and hrp then
        if (hrp.Position - PlayerLockPlatform.Position).Magnitude > 65 then
            hrp.CFrame = CFrame.new(PlayerLockPlatform.Position + Vector3.new(0, 5, 0))
        end
        pcall(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local pChar = plr.Character
                    local pHrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
                    local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
                    if pHrp and pHum and pHum.Health > 0 then
                        pHrp.CFrame = PlayerLockPlatform.CFrame + Vector3.new(0, 4, 0)
                        pHrp.Anchored = true
                        pHum.PlatformStand = true
                    end
                end
            end
        end)
    end
    
    if cleanActive and CleanPlatform and hrp then
        if (hrp.Position - CleanPlatform.Position).Magnitude > 55 then
            hrp.CFrame = CFrame.new(CleanPlatform.Position + Vector3.new(0, 5, 0))
        end
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local n = obj.Name:lower()
                    if n:match("candy") or n:match("trollbuck") or n:match("trollgem") or n:match("coin") or n:match("gem") or n:match("event") then
                        local tp = obj:IsA("Model") and obj.PrimaryPart or obj
                        if tp and tp:IsA("BasePart") then
                            tp.CFrame = CleanPlatform.CFrame + Vector3.new(math.random(-3, 3), 3, math.random(-3, 3))
                        end
                    end
                end
            end
        end)
    end
end)

