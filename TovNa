local pList,sIdx,bIdx={},1,1
local sTarget,bTarget=nil,nil
local bringPlt,bringActive=nil,false
local debounce=false

local function upList() pList={} for _,v in ipairs(P:GetPlayers()) do if v~=LP then table.insert(pList,v) end end end

local function clearAllPlatforms()
    pcall(function()
        for _, v in ipairs(WS:GetChildren()) do
            if v.Name == "AXBringPlatform" then
                v:Destroy()
            end
        end
    end)
end

local function releaseTarget(plr)
    pcall(function()
        if plr and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        end
    end)
end

local function handleSelect(typeStr)
    pcall(function()
        upList()
        if #pList == 0 then return end
        if typeStr == "s" then
            if sIdx > #pList then sIdx = 1 end
            sTarget = pList[sIdx]
            ST.Text = sTarget.Name SL.Text = "Spectating: "..sTarget.Name
            sIdx = sIdx + 1
        elseif typeStr == "b" then
            if bIdx > #pList then bIdx = 1 end
            releaseTarget(bTarget)
            bTarget = pList[bIdx]
            BST.Text = bTarget.Name BL.Text = "Bring Target: "..bTarget.Name
            bIdx = bIdx + 1
        end
    end)
end

RF.MouseButton1Click:Connect(function() sIdx=1 handleSelect("s") end)
ST.MouseButton1Click:Connect(function() handleSelect("s") end)
CLr.MouseButton1Click:Connect(function() sTarget=nil ST.Text="Select Player" SL.Text="Spectating: None" pcall(function() Cam.CameraSubject=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") end) end)

BRF.MouseButton1Click:Connect(function() bIdx=1 releaseTarget(bTarget) bTarget=nil BL.Text="Bring Target: None" handleSelect("b") end)
BST.MouseButton1Click:Connect(function() releaseTarget(bTarget) handleSelect("b") end)

BP.MouseButton1Click:Connect(function()
    if debounce then return end
    debounce = true
    task.delay(0.3, function() debounce = false end)

    bringActive = not bringActive
    BP.Text = "Bring Sky Platform: [ "..(bringActive and "ON" or "OFF").." ]"
    BP.BackgroundColor3 = bringActive and Color3.fromRGB(80,20,80) or Color3.fromRGB(60,20,60)
    
    clearAllPlatforms()
    
    if bringActive then
        bringPlt = Instance.new("Part",WS)
        bringPlt.Name = "AXBringPlatform"
        bringPlt.Size = Vector3.new(120,5,120)
        bringPlt.Position = Vector3.new(0,5000,0)
        bringPlt.Anchored = true
        bringPlt.CanCollide = true
        bringPlt.Color = Color3.fromRGB(150,50,150)
        pcall(function()
            if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                LP.Character.HumanoidRootPart.CFrame = CFrame.new(0,5006,15)
            end
        end)
    else
        releaseTarget(bTarget)
        bringPlt = nil
    end
end)

local espNames, espBoxes, espTracers, espSkeletons = {}, {}, {}, {}

RS.Heartbeat:Connect(function()
    pcall(function()
        local c=LP.Character local r=c and c:FindFirstChild("HumanoidRootPart")
        if sTarget and sTarget.Character then local h=sTarget.Character:FindFirstChildOfClass("Humanoid") if h then Cam.CameraSubject=h end end

        if bringActive and bTarget and bTarget.Character and bTarget.Character:FindFirstChild("HumanoidRootPart") then
            local bHrp = bTarget.Character.HumanoidRootPart
            local bHum = bTarget.Character:FindFirstChildOfClass("Humanoid")
            if not bringPlt or not bringPlt.Parent then
                clearAllPlatforms()
                bringPlt = Instance.new("Part",WS)
                bringPlt.Name = "AXBringPlatform"
                bringPlt.Size = Vector3.new(120,5,120)
                bringPlt.Position = Vector3.new(0,5000,0)
                bringPlt.Anchored = true
                bringPlt.CanCollide = true
                bringPlt.Color = Color3.fromRGB(150,50,150)
            end
            bHrp.CFrame = CFrame.new(0,5006,0)
            bHrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
            bHrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
            if bHum then bHum.PlatformStand = true end
        else
            if bringPlt and not bringActive then
                releaseTarget(bTarget)
                clearAllPlatforms()
                bringPlt=nil
            end
        end

        -- Name ESP
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=LP and plr.Character and plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                if NameES then
                    if not espNames[plr] then local txt = Drawing.new("Text") txt.Visible = false txt.Center = true txt.Outline = true txt.Color = Color3.fromRGB(255,50,50) txt.Size = 13 espNames[plr] = txt end
                    local vec, onScreen = Cam:WorldToViewportPoint(head.Position)
                    local txt = espNames[plr]
                    if onScreen then
                        txt.Text = plr.Name txt.Position = Vector2.new(vec.X, vec.Y - 25) txt.Visible = true
                    else
                        txt.Visible = false
                    end
                else
                    if espNames[plr] then espNames[plr].Visible = false espNames[plr]:Remove() espNames[plr] = nil end
                end
            end
        end

        -- Box ESP
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if BoxES then
                    if not espBoxes[plr] then local box = Drawing.new("Square") box.Visible = false box.Color = Color3.fromRGB(255,50,50) box.Thickness = 1.5 box.Filled = false espBoxes[plr] = box end
                    local vec, onScreen = Cam:WorldToViewportPoint(hrp.Position)
                    local box = espBoxes[plr]
                    if onScreen then
                        local size = math.clamp(2000 / vec.Z, 15, 300)
                        box.Size = Vector2.new(size * 0.6, size) box.Position = Vector2.new(vec.X - box.Size.X / 2, vec.Y - box.Size.Y / 2) box.Visible = true
                    else
                        box.Visible = false
                    end
                else
                    if espBoxes[plr] then espBoxes[plr].Visible = false espBoxes[plr]:Remove() espBoxes[plr] = nil end
                end
            end
        end

        -- Tracer ESP
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if TracerES then
                    if not espTracers[plr] then local tr = Drawing.new("Line") tr.Visible = false tr.Color = Color3.fromRGB(50,255,50) tr.Thickness = 1.5 espTracers[plr] = tr end
                    local vec, onScreen = Cam:WorldToViewportPoint(hrp.Position)
                    local tr = espTracers[plr]
                    if onScreen then
                        tr.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y) tr.To = Vector2.new(vec.X, vec.Y) tr.Visible = true
                    else
                        tr.Visible = false
                    end
                else
                    if espTracers[plr] then espTracers[plr].Visible = false espTracers[plr]:Remove() espTracers[plr] = nil end
                end
            end
        end

        -- Skeleton ESP
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local char = plr.Character
                if SkelES then
                    if not espSkeletons[plr] then
                        espSkeletons[plr] = { Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line") }
                        for _, l in ipairs(espSkeletons[plr]) do l.Visible = false l.Color = Color3.fromRGB(255,255,255) l.Thickness = 1.5 end
                    end
                    local head, torso = char:FindFirstChild("Head"), char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                    local lArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Lower Arm")
                    local rArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand") or char:FindFirstChild("Right Lower Arm")
                    local lLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Lower Leg")
                    local rLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Lower Leg")
                    if head and torso then
                        local hP, hOn = Cam:WorldToViewportPoint(head.Position)
                        local tP = Cam:WorldToViewportPoint(torso.Position)
                        if hOn then
                            espSkeletons[plr][1].From = Vector2.new(hP.X, hP.Y) espSkeletons[plr][1].To = Vector2.new(tP.X, tP.Y) espSkeletons[plr][1].Visible = true
                            if lArm then local laP = Cam:WorldToViewportPoint(lArm.Position) espSkeletons[plr][2].From = Vector2.new(tP.X, tP.Y) espSkeletons[plr][2].To = Vector2.new(laP.X, laP.Y) espSkeletons[plr][2].Visible = true end
                            if rArm then local raP = Cam:WorldToViewportPoint(rArm.Position) espSkeletons[plr][3].From = Vector2.new(tP.X, tP.Y) espSkeletons[plr][3].To = Vector2.new(raP.X, raP.Y) espSkeletons[plr][3].Visible = true end
                            if lLeg then local llP = Cam:WorldToViewportPoint(lLeg.Position) espSkeletons[plr][4].From = Vector2.new(tP.X, tP.Y) espSkeletons[plr][4].To = Vector2.new(llP.X, llP.Y) espSkeletons[plr][4].Visible = true end
                            if rLeg then local rlP = Cam:WorldToViewportPoint(rLeg.Position) espSkeletons[plr][5].From = Vector2.new(tP.X, tP.Y) espSkeletons[plr][5].To = Vector2.new(rlP.X, rlP.Y) espSkeletons[plr][5].Visible = true end
                        else
                            for _, l in ipairs(espSkeletons[plr]) do l.Visible = false end
                        end
                    end
                else
                    if espSkeletons[plr] then
                        for _, l in ipairs(espSkeletons[plr]) do
                            pcall(function() l.Visible = false l:Remove() end)
                        end
                        espSkeletons[plr] = nil
                    end
                end
            end
        end

        if FA and FP and r then if (r.Position-FP.Position).Magnitude>70 then r.CFrame=CFrame.new(FP.Position+Vector3.new(0,5,0)) end for _,v in ipairs(WS:GetChildren()) do if v:IsA("Model") and v~=c and not P:GetPlayerFromCharacter(v) then local h=v:FindFirstChildOfClass("Humanoid") local rp=v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") if h and rp and h.Health>0 then rp.CFrame=FP.CFrame+Vector3.new(0,4,0) rp.Anchored=true h.PlatformStand=true end end end end
        if FLck and FL and r then if (r.Position-FL.Position).Magnitude>70 then r.CFrame=CFrame.new(FL.Position+Vector3.new(0,5,0)) end for _,plr in ipairs(P:GetPlayers()) do if plr~=LP then local pc=plr.Character local prp=pc and pc:FindFirstChild("HumanoidRootPart") local ph=pc and pc:FindFirstChildOfClass("Humanoid") if prp and ph and ph.Health>0 then prp.CFrame=FL.CFrame+Vector3.new(0,4,0) prp.Anchored=true ph.PlatformStand=true end end end end
        if CL and CP and r then if (r.Position-CP.Position).Magnitude>60 then r.CFrame=CFrame.new(CP.Position+Vector3.new(0,5,0)) end for _,o in ipairs(WS:GetDescendants()) do if o:IsA("BasePart") or o:IsA("Model") then local n=o.Name:lower() if n:match("candy") or n:match("trollbuck") or n:match("coin") then local tp=o:IsA("Model") and o.PrimaryPart or o if tp and tp:IsA("BasePart") then tp.CFrame=CP.CFrame+Vector3.new(0,3,0) end end end end end
    end)
end)

