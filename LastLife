-- Main Engine Loop
RunService.Heartbeat:Connect(function()
    pcall(function()
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")

        if sBoss and sBoss.Parent then
            local hum = sBoss:FindFirstChildOfClass("Humanoid")
            if hum then Camera.CameraSubject = hum end
        end

        if (bringAllActive or bringSelActive) then
            if not bringPlt or not bringPlt.Parent then
                bringPlt = Instance.new("Part", Workspace)
                bringPlt.Name = "AXBossPlatform"
                bringPlt.Size = Vector3.new(120, 5, 120)
                bringPlt.Position = Vector3.new(0, 5000, 0)
                bringPlt.Anchored = true
                bringPlt.CanCollide = true
                bringPlt.Color = Color3.fromRGB(150, 50, 150)
            end
            if rootPart and (rootPart.Position - bringPlt.Position).Magnitude > 70 then
                rootPart.CFrame = CFrame.new(bringPlt.Position + Vector3.new(0, 6, 0))
            end
        end

        if bringAllActive and bringPlt then
            local activeBosses = getBosses()
            local idx = 0
            for _, v in ipairs(activeBosses) do
                local hum = v:FindFirstChildOfClass("Humanoid")
                local rp = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("Head")
                if hum and rp and hum.Health > 0 then
                    idx += 1
                    local angle = idx * (math.pi * 2 / math.max(#activeBosses, 1))
                    local offset = Vector3.new(math.cos(angle) * 12, 4, math.sin(angle) * 12)
                    rp.CFrame = bringPlt.CFrame + offset
                    rp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rp.Anchored = true
                    hum.PlatformStand = true
                end
            end
        end

        if bringSelActive and bringPlt and bBoss and bBoss.Parent then
            local hum = bBoss:FindFirstChildOfClass("Humanoid")
            local rp = bBoss:FindFirstChild("HumanoidRootPart") or bBoss:FindFirstChild("Torso") or bBoss:FindFirstChild("Head")
            if hum and rp and hum.Health > 0 then
                rp.CFrame = bringPlt.CFrame + Vector3.new(0, 4, 0)
                rp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rp.Anchored = true
                hum.PlatformStand = true
            end
        end
    end)
end)

