-- FE Staff Checker
local function checkPlayerForStaff(player: Player)
    if player == LocalPlayer then return end
    if KNOWN_STAFF[player.UserId] or KNOWN_STAFF[player.Name] then
        local rankName = KNOWN_STAFF[player.UserId] or KNOWN_STAFF[player.Name]
        sendNotification("⚠️ STAFF DETECTED: " .. player.Name .. " (" .. rankName .. ")", Color3.fromRGB(255, 0, 0), 10)
        return
    end

    task.spawn(function()
        local success, role = pcall(function() return player:GetRoleInGroup(TIFR_GROUP_ID) end)
        local success2, rank = pcall(function() return player:GetRankInGroup(TIFR_GROUP_ID) end)

        if success and rank and rank >= 10 then
            sendNotification("⚠️ STAFF JOINED: " .. player.Name .. " [" .. tostring(role) .. "]", Color3.fromRGB(255, 0, 0), 10)
        end
    end)
end

local function scanServerStaff()
    local found = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            checkPlayerForStaff(p)
            found += 1
        end
    end
    sendNotification("Staff Scan Completed (" .. found .. " players checked)", Color3.fromRGB(50, 255, 50), 3)
end

