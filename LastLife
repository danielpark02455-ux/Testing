local function isTIFRBoss(v: Model): boolean
    if not v:IsA("Model") or v == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(v) then return false end
    local hum = v:FindFirstChildOfClass("Humanoid")
    local rp = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso")
    if not hum or not rp or hum.Health <= 0 then return false end

    local name = v.Name:lower()
    local keywords = {"flinger", "asclepius", "maximus", "impasta", "consumer", "derp", "trollface", "boss", "raid", "titan", "crazed"}
    for _, kw in ipairs(keywords) do
        if name:find(kw) then return true end
    end
    return hum.MaxHealth >= 1500 or hum.Health >= 1500
end

local function getBosses(): {Model}
    local list = {}
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and isTIFRBoss(v) then
            table.insert(list, v)
        end
    end
    return list
end

local function clearPlatform()
    pcall(function()
        if bringPlt and bringPlt.Parent then bringPlt:Destroy() end
        bringPlt = nil
    end)
end

local function releaseBoss(boss: Model?)
    pcall(function()
        if boss and boss.Parent then
            local hum = boss:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            local rp = boss:FindFirstChild("HumanoidRootPart") or boss:FindFirstChild("Torso")
            if rp then rp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        end
    end)
end

